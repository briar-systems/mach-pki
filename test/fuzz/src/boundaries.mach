# every untrusted-input entry point the lane answers, by corpus directory name

use std.types.option.opt;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use fuzz.verdict;
use fuzz.x509;

pub def AnswerFn: fun(*u8, usize) verdict.Verdict;

pub rec Boundary {
    name:   str;
    answer: AnswerFn;
}

pub val CAPACITY: usize = 32;

fun put(out: *Boundary, i: usize, name: str, answer: AnswerFn) usize {
    if (i >= CAPACITY) { ret i; }
    out[i].name   = name;
    out[i].answer = answer;
    ret i + 1;
}

pub fun all(out: *Boundary) usize {
    var i: usize = 0;
    i = put(out, i, "x509", x509.answer);
    ret i;
}

pub fun lookup(table: *Boundary, n: usize, name: str) opt[usize] {
    var i: usize = 0;
    for (i < n) {
        if (str_equals(table[i].name, name)) { ret opt[usize].some{i}; }
        i = i + 1;
    }
    ret opt[usize].none{};
}
