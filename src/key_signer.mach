#[testing]
rec Fixture {
    der:    [2048]u8;
    owner:  secret.Allocator;
    signer: KeySigner;
}

#[testing]
fun open_fixture(fixture: *Fixture, key_pem: *u8, chain_pem: *u8) contract.Error {
    var key:     [2048]^u8;
    val key_len: usize = str_len(key_pem);
    var i:       usize = 0;
    for (i < key_len) {
        key[i] = key_pem[i];
        i      = i + 1;
    }
    fixture.owner = secret.system_allocator();
    val opened: contract.Error = open_pem(?fixture.signer,
        contracts.SecretBytes{data: ?key[0], len: key_len},
        contracts.Bytes{data: chain_pem, len: str_len(chain_pem)},
        contracts.Buffer{data: ?fixture.der[0], capacity: 2048}, ?fixture.owner);
    ct.zeroize(?key[0], 2048);
    ret opened;
}

# sign through the contract and verify under the leaf's public key
#[testing]
fun signs_and_verifies(value: *contract.Signer,
    wanted: x509.SignatureAlgorithm) bool {
    var message: [11]u8          = [11]u8{'s', 'i', 'g', 'n', 'e', 'd', ' ', 'a', 't', 't', 'r'};
    var output:  [512]u8;
    val made:    contract.Result = contract.sign(value, wanted,
        contracts.Bytes{data: ?message[0], len: 11},
        contracts.Buffer{data: ?output[0], capacity: 512});
    if (made.error != contract.OK || made.written == 0 ||
        made.written > contract.signature_size(value, wanted)) { ret false; }
    val presented: cert.Chain = contract.chain(value);
    var leaf:      x509.Certificate;
    if (presented.len != 1 || x509.parse(contracts.Bytes{
        data: presented.certificates[0].der, len: presented.certificates[0].der_len
    },
        ?leaf) != contracts.OK) { ret false; }
    if (verify.message(?leaf.public_key, wanted,
        contracts.Bytes{data: ?message[0], len: 11},
        contracts.Bytes{data: ?output[0], len: made.written}) != verify.OK) { ret false; }
    message[0] = 'S';
    ret verify.message(?leaf.public_key, wanted,
        contracts.Bytes{data: ?message[0], len: 11},
        contracts.Bytes{data: ?output[0], len: made.written}) == verify.BAD_SIGNATURE;
}

test key_signer__ed25519_key_signs_the_message_itself {
    var fixture: Fixture;
    if (open_fixture(?fixture, ED25519_KEY, ED25519_CHAIN) != contract.OK) { ret 1; }
    var value: contract.Signer = signer(?fixture.signer);
    if (contract.algorithm(?value, 0) != x509.ED25519 ||
        contract.algorithm(?value, 1) != x509.SIGNATURE_NONE ||
        contract.signature_size(?value, x509.ED25519) != 64) { ret 2; }
    if (!signs_and_verifies(?value, x509.ED25519)) { ret 3; }
    if (close(?fixture.signer) != contract.OK)     { ret 4; }
    ret 0;
}

test key_signer__ecdsa_p256_sec1_key_signs {
    var fixture: Fixture;
    if (open_fixture(?fixture, P256_KEY, P256_CHAIN) != contract.OK) { ret 1; }
    var value: contract.Signer = signer(?fixture.signer);
    if (contract.algorithm(?value, 0) != x509.ECDSA_P256_SHA256 ||
        contract.supports(?value, x509.ECDSA_P384_SHA384)) { ret 2; }
    if (!signs_and_verifies(?value, x509.ECDSA_P256_SHA256)) { ret 3; }
    if (close(?fixture.signer) != contract.OK)               { ret 4; }
    ret 0;
}

test key_signer__rsa_key_signs_pss_and_not_pkcs1 {
    var fixture: Fixture;
    if (open_fixture(?fixture, RSA_KEY, RSA_CHAIN) != contract.OK) { ret 1; }
    var value: contract.Signer = signer(?fixture.signer);
    if (contract.algorithm(?value, 0) != x509.RSA_PSS_SHA256 ||
        contract.algorithm(?value, 1) != x509.RSA_PSS_SHA384 ||
        contract.algorithm(?value, 2) != x509.SIGNATURE_NONE ||
        contract.signature_size(?value, x509.RSA_PSS_SHA256) != 256) { ret 2; }
    var output: [256]u8;
    if (contract.sign(?value, x509.RSA_PKCS1_SHA256,
        contracts.Bytes{data: nil, len: 0},
        contracts.Buffer{data: ?output[0], capacity: 256}).error !=
        contract.UNSUPPORTED_ALGORITHM) { ret 3; }
    if (!signs_and_verifies(?value, x509.RSA_PSS_SHA256) ||
        !signs_and_verifies(?value, x509.RSA_PSS_SHA384)) { ret 4; }
    if (close(?fixture.signer) != contract.OK) { ret 5; }
    ret 0;
}

test key_signer__a_key_must_belong_to_the_leaf {
    var fixture: Fixture;
    if (open_fixture(?fixture, ED25519_KEY, OTHER_ED25519_CHAIN) !=
        contract.KEY_MISMATCH ||
        open_fixture(?fixture, ED25519_KEY, P256_CHAIN) != contract.KEY_MISMATCH ||
        open_fixture(?fixture, RSA_KEY, ED25519_CHAIN) != contract.KEY_MISMATCH) {
        ret 1;
    }
    ret 0;
}
