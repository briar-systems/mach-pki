# signer over a private key held in memory with its certificate chain

use crypto.contracts;
use crypto.encoding.keys;
use crypto.group.p256;
use crypto.secret;
use crypto.signature;
use pki.cert;
use pki.load;
use contract: pki.signer;
use pki.verify;
use pki.x509;
use std.crypto.ct;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.size.usize;
use std.types.string.str_len;

# what signing needs besides the secret: the key's algorithm, its rsa public
# parts and the chain
pub rec KeyState {
    algorithm:    keys.Algorithm;
    modulus:      [512]u8;
    modulus_len:  usize;
    exponent:     [512]u8;
    exponent_len: usize;
    chain:        cert.Chain;
    certificates: [verify.MAX_CHAIN_DEPTH]cert.Certificate;
}

# an open key signer. it owns its key, borrows its chain's der, and must not
# move while a contract.Signer made from it is in use
pub rec KeySigner {
    state: KeyState;
    key:   keys.PrivateKey;
    # the rsa private exponent padded to the modulus length, empty otherwise
    rsa_private: secret.Secret;
}

fun bytes_equal(first: *u8, first_len: usize, second: contracts.Bytes) bool {
    if (first_len != second.len || first == nil || second.data == nil) { ret false; }
    var i: usize = 0;
    for (i < first_len) {
        if (first[i] != second.data[i]) { ret false; }
        i = i + 1;
    }
    ret true;
}

fun map_error(error: contracts.Error) contract.Error {
    if (error == contracts.OK)                  { ret contract.OK; }
    if (error == contracts.ENTROPY_UNAVAILABLE) { ret contract.UNAVAILABLE; }
    if (error == contracts.INVALID_INPUT)       { ret contract.INVALID_INPUT; }
    if (error == contracts.UNSUPPORTED)         { ret contract.UNSUPPORTED_ALGORITHM; }
    ret contract.FAILED;
}

fun failed(error: contract.Error) contract.Result {
    ret contract.Result{error: error, written: 0};
}

fun algorithm_at(key: keys.Algorithm, index: usize) x509.SignatureAlgorithm {
    if (key == keys.ED25519 && index == 0) { ret x509.ED25519; }
    if (key == keys.P256 && index == 0)    { ret x509.ECDSA_P256_SHA256; }
    if (key == keys.RSA) {
        if (index == 0) { ret x509.RSA_PSS_SHA256; }
        if (index == 1) { ret x509.RSA_PSS_SHA384; }
    }
    ret x509.SIGNATURE_NONE;
}

fun size_of(state: *KeyState, wanted: x509.SignatureAlgorithm) usize {
    if (state.algorithm == keys.ED25519 && wanted == x509.ED25519) {
        ret signature.ED25519_SIGNATURE_SIZE;
    }
    if (state.algorithm == keys.P256 && wanted == x509.ECDSA_P256_SHA256) {
        ret signature.ECDSA_P256_SIGNATURE_MAX_SIZE;
    }
    if (state.algorithm == keys.RSA &&
        (wanted == x509.RSA_PSS_SHA256 || wanted == x509.RSA_PSS_SHA384)) {
        ret state.modulus_len;
    }
    ret 0;
}

# the signing secret: the ed25519 seed or p-256 scalar, or the padded rsa
# private exponent
fun signing_secret(value: *KeySigner, output: *contracts.SecretBytes) contracts.Error {
    if (value.state.algorithm == keys.RSA) {
        ret secret.bytes(?value.rsa_private, 0, value.state.modulus_len, output);
    }
    ret keys.private_bytes(?value.key, output);
}

# check that the key is the private half of public_key and fill the state
fun prepare(value: *KeySigner, public_key: *keys.PublicKey) contract.Error {
    val algorithm: keys.Algorithm = value.key.algorithm;
    if (algorithm != public_key.algorithm) { ret contract.KEY_MISMATCH; }
    value.state.algorithm = algorithm;
    if (algorithm == keys.RSA) {
        val allocated: contracts.Error = secret.init(?value.rsa_private,
            value.key.material.owner, value.key.modulus_len);
        if (allocated != contracts.OK) { ret map_error(allocated); }
        var padded: contracts.SecretBuffer;
        var status: contracts.Error = secret.buffer(?value.rsa_private, 0,
            value.key.modulus_len, ?padded);
        if (status == contracts.OK) {
            status = keys.copy_rsa(?value.key,
                contracts.Buffer{data: ?value.state.modulus[0], capacity: 512},
                contracts.Buffer{data: ?value.state.exponent[0], capacity: 512}, padded);
        }
        if (status != contracts.OK) { ret map_error(status); }
        value.state.modulus_len  = value.key.modulus_len;
        value.state.exponent_len = value.key.exponent_len;
        if (!bytes_equal(?value.state.modulus[0], value.state.modulus_len,
            public_key.first) || !bytes_equal(?value.state.exponent[0],
            value.state.exponent_len, public_key.second)) { ret contract.KEY_MISMATCH; }
        ret contract.OK;
    }
    var private_key: contracts.SecretBytes;
    val viewed:      contracts.Error = keys.private_bytes(?value.key, ?private_key);
    if (viewed != contracts.OK) { ret map_error(viewed); }
    var derived: [65]u8;
    var made:    contracts.Operation;
    if (algorithm == keys.ED25519) {
        made = signature.derive_ed25519_public(private_key,
            contracts.Buffer{data: ?derived[0], capacity: 65});
    }
    or (algorithm == keys.P256) {
        made = p256.derive_public(private_key,
            contracts.Buffer{data: ?derived[0], capacity: 65});
    }
    or                              { ret contract.UNSUPPORTED_ALGORITHM; }
    if (made.error != contracts.OK) { ret map_error(made.error); }
    if (!bytes_equal(?derived[0], made.written, public_key.first)) {
        ret contract.KEY_MISMATCH;
    }
    ret contract.OK;
}

fun context_algorithm(context: ptr, index: usize) x509.SignatureAlgorithm {
    val state: *KeyState = context::*KeyState;
    ret algorithm_at(state.algorithm, index);
}

fun context_chain(context: ptr) cert.Chain {
    val state: *KeyState = context::*KeyState;
    ret state.chain;
}

fun context_signature_size(context: ptr, wanted: x509.SignatureAlgorithm) usize {
    val state: *KeyState = context::*KeyState;
    ret size_of(state, wanted);
}

fun sign_rsa(state: *KeyState, private_exponent: *^u8,
    wanted: x509.SignatureAlgorithm, message: contracts.Bytes,
    output: contracts.Buffer) contracts.Operation {
    var salt_len: usize = signature.RSA_PSS_SHA256_SALT_SIZE;
    if (wanted == x509.RSA_PSS_SHA384) { salt_len = signature.RSA_PSS_SHA384_SALT_SIZE; }
    var entropy: secret.Entropy = secret.system_entropy();
    var salt:    [48]^u8;
    if (entropy.fill_fn(entropy.context, entropy.secret_context, ?salt[0],
        salt_len) != 0) {
        ct.zeroize(?salt[0], 48);
        ret contracts.Operation{error: contracts.ENTROPY_UNAVAILABLE, written: 0};
    }
    val private_key: signature.RsaPrivateKey = signature.RsaPrivateKey{
        modulus:         contracts.Bytes{data: ?state.modulus[0], len: state.modulus_len},
        public_exponent: contracts.Bytes{data: ?state.exponent[0],
            len: state.exponent_len},
        private_exponent: contracts.SecretBytes{data: private_exponent,
            len: state.modulus_len},
    };
    val salt_bytes: contracts.SecretBytes = contracts.SecretBytes{data: ?salt[0],
        len: salt_len};
    var made: contracts.Operation;
    if (wanted == x509.RSA_PSS_SHA256) {
        made = signature.sign_rsa_pss_sha256(private_key, message, salt_bytes, output);
    }
    or { made = signature.sign_rsa_pss_sha384(private_key, message, salt_bytes, output); }
    ct.zeroize(?salt[0], 48);
    ret made;
}

fun context_sign(context: ptr, secret_context: *^u8, wanted: x509.SignatureAlgorithm,
    message: contracts.Bytes, output: contracts.Buffer) contract.Result {
    val state: *KeyState = context::*KeyState;
    if (size_of(state, wanted) == 0) { ret failed(contract.UNSUPPORTED_ALGORITHM); }
    if (secret_context == nil)       { ret failed(contract.INVALID_INPUT); }
    var made: contracts.Operation;
    if (state.algorithm == keys.RSA) {
        made = sign_rsa(state, secret_context, wanted, message, output);
    }
    or (state.algorithm == keys.ED25519) {
        made = signature.sign_ed25519(contracts.SecretBytes{data: secret_context,
            len: signature.ED25519_PRIVATE_KEY_SIZE}, message, output);
    }
    or {
        made = signature.sign_ecdsa_p256_sha256(contracts.SecretBytes{
            data: secret_context, len: signature.ECDSA_P256_PRIVATE_KEY_SIZE
        },
            message, output);
    }
    if (made.error != contracts.OK) { ret failed(map_error(made.error)); }
    ret contract.Result{error: contract.OK, written: made.written};
}

# open a signer over key and the leaf-first chain
#
# the key must be the private half of the leaf's public key and sign with at
# least one supported algorithm. on success the signer owns the key and the
# caller's key is left empty. on failure the caller keeps it. the chain's der
# is borrowed and must outlive the signer. rsa-pss salts come from the
# operating system.
pub fun open(output: *KeySigner, key: *keys.PrivateKey, chain: cert.Chain) contract.Error {
    if (output == nil || key == nil || chain.certificates == nil || chain.len == 0 ||
        chain.len > verify.MAX_CHAIN_DEPTH) { ret contract.INVALID_INPUT; }
    if (algorithm_at(key.algorithm, 0) == x509.SIGNATURE_NONE) {
        ret contract.UNSUPPORTED_ALGORITHM;
    }
    var leaf: x509.Certificate;
    if (x509.parse(contracts.Bytes{data: chain.certificates[0].der,
        len: chain.certificates[0].der_len}, ?leaf) != contracts.OK) {
        ret contract.INVALID_INPUT;
    }
    var opened: KeySigner;
    opened.key         = @key;
    opened.rsa_private = secret.empty();
    val prepared: contract.Error = prepare(?opened, ?leaf.public_key);
    if (prepared != contract.OK) {
        secret.destroy(?opened.rsa_private);
        ret prepared;
    }
    var i: usize = 0;
    for (i < chain.len) {
        opened.state.certificates[i] = chain.certificates[i];
        i                            = i + 1;
    }
    @output            = opened;
    output.state.chain = cert.Chain{certificates: ?output.state.certificates[0],
        len: chain.len};
    @key = keys.empty_private();
    ret contract.OK;
}

# open a signer from a pem private key and a leaf-first pem certificate chain
#
# key_pem holds a PRIVATE KEY, EC PRIVATE KEY or RSA PRIVATE KEY block. the
# chain's der is decoded into der_output, which must outlive the signer. owner
# allocates the key and must outlive the signer.
pub fun open_pem(output: *KeySigner, key_pem: contracts.SecretBytes,
    chain_pem: contracts.Bytes, der_output: contracts.Buffer,
    owner: *secret.Allocator) contract.Error {
    if (output == nil || owner == nil) { ret contract.INVALID_INPUT; }
    var certificates: [verify.MAX_CHAIN_DEPTH]cert.Certificate;
    var chain:        cert.Chain;
    val loaded:       contracts.Operation = load.chain_pem(chain_pem, der_output,
        ?certificates[0], verify.MAX_CHAIN_DEPTH, ?chain);
    if (loaded.error == contracts.OUTPUT_TOO_SMALL) { ret contract.OUTPUT_TOO_SMALL; }
    if (loaded.error != contracts.OK)               { ret contract.INVALID_INPUT; }
    var key:     keys.PrivateKey = keys.empty_private();
    val decoded: contracts.Error = load.private_pem(key_pem, owner, ?key);
    if (decoded == contracts.UNSUPPORTED) { ret contract.UNSUPPORTED_ALGORITHM; }
    if (decoded != contracts.OK)          { ret contract.INVALID_INPUT; }
    val opened: contract.Error = open(output, ?key, chain);
    if (opened != contract.OK) { keys.destroy_private(?key); }
    ret opened;
}

# destroy the signer's key
pub fun close(value: *KeySigner) contract.Error {
    if (value == nil) { ret contract.INVALID_INPUT; }
    var empty: cert.Chain;
    value.state.chain = empty;
    val padded: contracts.Error = secret.destroy(?value.rsa_private);
    if (keys.destroy_private(?value.key) != contracts.OK || padded != contracts.OK) {
        ret contract.FAILED;
    }
    ret contract.OK;
}

# the contract over an open key signer, valid until it is closed or moved
pub fun signer(value: *KeySigner) contract.Signer {
    var closed:       contract.Signer;
    var secret_bytes: contracts.SecretBytes;
    if (value == nil || signing_secret(value, ?secret_bytes) != contracts.OK) {
        ret closed;
    }
    ret contract.Signer{
        context:           (?value.state)::ptr,
        secret_context:    secret_bytes.data,
        algorithm_fn:      context_algorithm,
        chain_fn:          context_chain,
        signature_size_fn: context_signature_size,
        sign_fn:           context_sign,
    };
}

